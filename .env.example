# JWT Secret for authentication signing
JWT_SECRET="sadhukhan_varities_super_secure_jwt_secret_key_2026"

# Cloudinary credentials for product image & due-payment proof storage (Free Tier)
# If omitted, system seamlessly stores optimized compressed images directly.
